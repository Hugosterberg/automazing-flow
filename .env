# OAuth credentials – skapa appar på varje plattform och fyll i här
# Se README för inställningsinstruktioner

# OpenAI – används för AI-analys av konton (hämta nyckel på platform.openai.com)
OPENAI_API_KEY=

# Instagram via Late API (rekommenderat – enklare, ingen Meta-verifiering)
# Skapa konto på https://getlate.dev och använd API-nyckel
LATE_API_KEY=sk_e2cd127f5170ce088f3f05a78326468766b2dc6a91a5770189a82aa844554413
# Valfritt: Late profile-id. Om tom skapas/ används standardprofil via API.
# LATE_PROFILE_ID=

# Instagram (Meta for Developers – fallback om Late inte används)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube/Gmail (Google Cloud Console – OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Outlook (Microsoft Entra/Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# URL:er för OAuth callbacks (anpassa för din miljö)
# Lokal utveckling: http://localhost:8080 (frontend) + http://localhost:3001 (backend)
BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:3001

# Frontend: API-URL (valfritt). Om ej satt används /api som fungerar med Vite-proxy i dev.
# För preview/produktion: sätt t.ex. VITE_API_URL=http://localhost:3001
# VITE_API_URL=
