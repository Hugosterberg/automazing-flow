{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/lead-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/task-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cleanup-oauth-pending",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/refresh-ai-recommendations",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/auto-reply",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/publish-scheduled-posts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sales-outreach-auto",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/content-pipeline",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cart-recovery",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/review-reply-auto",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/mail-reply-auto",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/marketing-actions",
      "schedule": "30 7 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-insight-digest",
      "schedule": "30 8 * * 1"
    },
    {
      "path": "/api/cron/engagement-followup",
      "schedule": "0 10,16 * * 1-5"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/marketing-alerts",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/cron/marketing-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/social-stats-snapshot",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/market-pulse-snapshot",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "30 7 * * 1"
    },
    {
      "path": "/api/cron/post-purchase-review-request",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/customer-winback",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/product-content-automation",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/fortnox-invoice-suggest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/fortnox-payment-sync",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/fortnox-refund-credit-suggest",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/**"
    }
  }
}
