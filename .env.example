# Kopiera till .env och fyll i värden. Översikt: docs/KOPPLINGAR.md

OPENAI_API_KEY=

# Zernio — Instagram-inloggning + länkning av fler kanaler (Facebook, WhatsApp, …)
ZERNIO_API_KEY=
# ZERNIO_PROFILE_ID=
# ZERNIO_API_BASE=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL used by Shopify Application URL + callback host in local tunnel setups.
# Example: https://your-subdomain.trycloudflare.com
# SHOPIFY_APP_URL=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Public HTTPS URL for Notion OAuth callback host (can be same as SHOPIFY_APP_URL).
# Example: https://your-subdomain.trycloudflare.com
# NOTION_APP_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:3001
# VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional server-side names (if you do not want VITE_* fallback):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
