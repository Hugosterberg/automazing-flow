# Kopiera till .env och fyll i värden. Översikt: docs/KOPPLINGAR.md

OPENAI_API_KEY=

# Zernio — Instagram-inloggning + länkning av fler kanaler (Facebook, WhatsApp, …)
ZERNIO_API_KEY=
# ZERNIO_PROFILE_ID=
# ZERNIO_API_BASE=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL used by Shopify Application URL + callback host in local tunnel setups.
# Example: https://your-subdomain.trycloudflare.com
# SHOPIFY_APP_URL=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Public HTTPS URL for Notion OAuth callback host (can be same as SHOPIFY_APP_URL).
# Example: https://your-subdomain.trycloudflare.com
# NOTION_APP_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Tripadvisor official API fallback for Reviews tab (if Zernio is unavailable)
# TRIPADVISOR_API_KEY=
# TRIPADVISOR_LOCATION_ID=

BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:3001
# On Vercel (VERCEL=1), if API_BASE_URL/BASE_URL are missing or still localhost, the server uses https://VERCEL_URL so Zernio/Meta redirects hit production, not localhost:3001.
# VITE_API_URL=  (optional: same-origin on Vercel leave empty; external API use https://api.example.com)
# Public URL of the app (OAuth return + redirects). On Vercel, deployment URL is also injected at build (VERCEL_URL).
VITE_APP_URL=http://localhost:8080
# Optional override (production / custom domain). If unset on Vercel, build uses VERCEL_URL automatically.
# VITE_SITE_URL=
VITE_SUPABASE_URL=
# New Supabase UI uses publishable key; legacy anon key still works.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Older template name (still supported in code):
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Optional server-side names (if you do not want VITE_* fallback):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# --- Vercel + Supabase (set in Vercel Project → Settings → Environment Variables) ---
# BASE_URL=https://your-app.vercel.app
# API_BASE_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
# VITE_APP_URL=https://your-app.vercel.app
# VITE_SUPABASE_URL= (same as local)
# VITE_SUPABASE_PUBLISHABLE_KEY= or VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL= (optional mirror for server)
# SUPABASE_PUBLISHABLE_KEY= or SUPABASE_ANON_KEY=
# All OAuth/API secrets: GOOGLE_CLIENT_*, ZERNIO_API_KEY, MICROSOFT_*, etc.
# NODE_OPTIONS=--experimental-strip-types   (needed so server can import .ts modules on Node 22)
